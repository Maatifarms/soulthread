{
  "name": "soulthread",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:user": "vite --config vite.config.user.js",
    "dev:guide": "vite --config vite.config.guide.js --port 5174",
    "build:user": "vite build --config vite.config.user.js && node -e \"require('fs').copyFileSync('dist-user/index-user.html', 'dist-user/index.html')\"",
    "build:guide": "vite build --config vite.config.guide.js && node -e \"require('fs').copyFileSync('dist-guide/index-guide.html', 'dist-guide/index.html')\"",
    "sync:user": "npm run build:user && npx cap sync android",
    "sync:guide": "npm run build:guide && npx cap copy android",
    "build:all": "npm run build:user && npm run build:guide",
    "prebuild": "node scripts/generate-sitemap.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:firebase": "npm run build:user && firebase deploy --only hosting",
    "deploy:hostinger": "npm run build:user && node scripts/deploy-hostinger.cjs",
    "report:seo": "node scripts/daily-seo-report.js"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.1.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@tanstack/react-query": "^5.101.4",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.8.0",
    "framer-motion": "^12.35.0",
    "googleapis": "^171.4.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.7.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.9.2",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.3.1",
    "enhanced-resolve": "^5.24.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.6.1",
    "ftp-deploy": "^2.4.7",
    "globals": "^16.5.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "terser": "^5.46.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
