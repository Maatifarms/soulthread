# ==============================================================================
# SOULTHREAD PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the `functions/` directory.
# 2. Replace the placeholders with your actual production/sandbox secrets.
# 3. DO NOT commit the `.env` file to version control.
#
# Note: In production, it is highly recommended to use Firebase Secret Manager
# instead of `.env` files for critical secrets like API Keys. 
# Run `firebase functions:secrets:set SECRET_NAME` to inject secrets securely.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CASHFREE (PAYMENT GATEWAY)
# ------------------------------------------------------------------------------
# Set to 'sandbox' for testing, 'production' for live payments
CASHFREE_ENV="sandbox"

# API Keys (Found in Cashfree Dashboard -> Developers -> API Keys)
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"

# Webhook Secret (Found in Cashfree Dashboard -> Developers -> Webhooks)
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret_here"


# ------------------------------------------------------------------------------
# 2. DAILY.CO (WEBRTC VIDEO SESSIONS)
# ------------------------------------------------------------------------------
# API Key (Found in Daily.co Dashboard -> Developers)
DAILY_API_KEY="your_daily_api_key_here"


# ------------------------------------------------------------------------------
# 3. NODEMAILER / SMTP (EMAIL SERVICE)
# ------------------------------------------------------------------------------
# SMTP Configuration for sending transactional emails (Confirmations, Resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@soulthread.in"
SMTP_PASS="your_app_specific_password_here"

# Default sender address
EMAIL_FROM_ADDRESS="SoulThread <noreply@soulthread.in>"


# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN / SYSTEM
# ------------------------------------------------------------------------------
# Node Environment ('development' or 'production')
NODE_ENV="production"

# Application Base URL (Used for generating email links and webhooks)
APP_BASE_URL="https://soulthread.in"

# Admin Override Emails (Comma-separated list of emails that bypass standard auth)
ADMIN_EMAILS="rupesh2510@gmail.com,anchalmaurya406@gmail.com,bhavyajha.bhu@gmail.com"
